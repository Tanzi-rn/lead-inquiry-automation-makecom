                "to": [
                    "thansiacr@gmail.com"
                ],
                "subject": "New Lead Inquiry",
                "bodyType": "collection",
                "contents": [
                    {
                        "text": "New lead received:\r\n\r\nName: {{1.`1`}}\r\nQualification: {{1.`2`}}\r\nEmail: {{1.`3`}}\r\nPhone: {{1.`4`}}\r\nMessage: {{1.`5`}}",
